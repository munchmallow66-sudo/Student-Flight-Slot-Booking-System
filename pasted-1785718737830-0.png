/* AviCore — Typography tokens
   IBM Plex Sans (Latin) + Noto Sans Thai (Thai) + IBM Plex Mono (data). */
:root {
  --font-sans: "IBM Plex Sans", "Noto Sans Thai", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, monospace;

  /* Scale — compact ERP */
  --text-xs: 11px;
  --text-sm: 12.5px;
  --text-base: 14px;
  --text-md: 16px;
  --text-lg: 18px;
  --text-xl: 22px;
  --text-2xl: 28px;
  --text-3xl: 36px;

  --leading-tight: 1.25;
  --leading-normal: 1.5;

  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* Semantic */
  --type-page-title: var(--weight-semibold) var(--text-xl)/var(--leading-tight) var(--font-sans);
  --type-section-title: var(--weight-semibold) var(--text-md)/var(--leading-tight) var(--font-sans);
  --type-body: var(--weight-regular) var(--text-base)/var(--leading-normal) var(--font-sans);
  --type-body-sm: var(--weight-regular) var(--text-sm)/var(--leading-normal) var(--font-sans);
  --type-label: var(--weight-medium) var(--text-sm)/var(--leading-tight) var(--font-sans);
  --type-overline: var(--weight-semibold) var(--text-xs)/var(--leading-tight) var(--font-sans);
  --type-data: var(--weight-regular) var(--text-sm)/var(--leading-normal) var(--font-mono);
  --type-stat: var(--weight-semibold) var(--text-2xl)/var(--leading-tight) var(--font-sans);

  --tracking-overline: 0.08em;
}
